{
  "name": "accounting-platform",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Local-first TypeScript accounting backend with a React browser client and documented release gates",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.16.0 <23 || >=24.0.0 <25 || >=26.0.0 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:types": "tsc -p tsconfig.json",
    "check:docs": "node --experimental-strip-types scripts/check-docs.ts",
    "check:sources": "node --experimental-strip-types scripts/check-sources.ts",
    "check": "pnpm run check:types && pnpm run check:docs && pnpm run check:sources && pnpm run check:boundaries",
    "test": "node --experimental-strip-types --test tests/infrastructure/*.test.ts tests/identity/*.test.ts tests/accounting/*.test.ts tests/trading/*.test.ts tests/ai/*.test.ts tests/server/*.test.ts tests/web/*.test.ts",
    "verify": "pnpm run check && pnpm run build && pnpm run test",
    "setup": "node --experimental-strip-types scripts/app.ts setup",
    "app:doctor": "node --experimental-strip-types scripts/app.ts doctor",
    "db:migrate": "node --experimental-strip-types scripts/app.ts db:migrate",
    "db:status": "node --experimental-strip-types scripts/app.ts db:status",
    "db:check": "node --experimental-strip-types scripts/app.ts db:check",
    "app:bootstrap": "node --experimental-strip-types scripts/app.ts company:bootstrap",
    "app:recover-admin": "node --experimental-strip-types scripts/app.ts admin:recover",
    "check:boundaries": "node --experimental-strip-types scripts/check-boundaries.ts",
    "app:serve": "node --experimental-strip-types scripts/app.ts server:start",
    "app:backup": "node --experimental-strip-types scripts/app.ts backup:create",
    "app:backup-verify": "node --experimental-strip-types scripts/app.ts backup:verify",
    "app:restore": "node --experimental-strip-types scripts/app.ts backup:restore",
    "web:dev": "pnpm --dir web dev",
    "web:build": "pnpm --dir web build",
    "web:check": "pnpm --dir web check",
    "verify:all": "pnpm run verify && pnpm run web:check && pnpm run web:build && pnpm run web:e2e",
    "handoff:check": "node --experimental-strip-types scripts/handoff-check.ts",
    "handoff:release": "node --experimental-strip-types scripts/handoff-check.ts --release --strict",
    "web:e2e": "pnpm --dir web e2e"
  },
  "devDependencies": {
    "@types/node": "25.1.0",
    "typescript": "5.8.3"
  }
}
